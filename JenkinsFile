pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('List Files') {
            steps {
                sh 'ls -R'
            }
        }

        stage('Validate HTML Exists') {
            steps {
                sh '''
                    test -f HTMLS/products.html
                    echo "products.html found yay"
                '''
            }
        }

        stage('Done') {
            steps {
                echo 'Frontend pipeline completed successfully'
            }
        }
    }
}